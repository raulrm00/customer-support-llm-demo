.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Python build artifacts
build/
dist/
*.egg-info/

# Local model and data artifacts
ml/data/raw/*
ml/data/processed/*
ml/data/splits/*
ml/models/*.joblib
ml/models/*.pkl

# Keep placeholder files when added intentionally
!ml/data/**/.gitkeep
!ml/models/.gitkeep
!ml/data/raw/*.dvc

# Frontend local tooling and generated files
frontend/.vscode/
frontend/node_modules/
frontend/dist/
frontend/.angular/cache/
frontend/coverage/
