APP_ENV=local
APP_NAME=Customer Support Classifier API
API_VERSION=1.0.0
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

CORS_ALLOWED_ORIGINS=["http://localhost:4200"]

MODEL_ARTIFACT_PATH=ml/models/modelo_idf.joblib
MODEL_METADATA_PATH=ml/models/model_metadata.json
MODEL_VERSION=1.0.0
PIPELINE_VERSION=1.0.0

LOG_LEVEL=INFO

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=customer_support
DATABASE_URL=postgresql://postgres:postgres@db:5432/customer_support

# Auth
JWT_SECRET_KEY=yoursecretkeyhere
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Usage Limits
DEFAULT_DAILY_LIMIT_SECONDS=3600
